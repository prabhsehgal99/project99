rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validDateKey(date) {
      return date.matches('^[1-9]\\d{3}-(01|03|05|07|08|10|12)-(0[1-9]|[12]\\d|3[01])$')
        || date.matches('^[1-9]\\d{3}-(04|06|09|11)-(0[1-9]|[12]\\d|30)$')
        || date.matches('^[1-9]\\d{3}-02-(0[1-9]|1\\d|2[0-8])$')
        || date.matches('^(?:[1-9]\\d(?:0[48]|[2468][048]|[13579][26])|(?:[2468][048]|[13579][26])00)-02-29$');
    }

    function zeroPadded(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    function isFutureDateKey(date) {
      let parts = date.split('-');
      let currentYear = string(request.time.year());
      let currentMonth = zeroPadded(request.time.month());
      let currentDay = zeroPadded(request.time.day());
      return parts[0] > currentYear
        || (parts[0] == currentYear && parts[1] > currentMonth)
        || (parts[0] == currentYear && parts[1] == currentMonth && parts[2] > currentDay);
    }

    function validActivityStatus(value) {
      return value in ['planned', 'complete', 'rest', 'missed'];
    }

    function validNullableNumber(value, min, max) {
      return value == null || (value is number && value >= min && value <= max);
    }

    function validScale(value) {
      return value == null || (value is int && value >= 1 && value <= 5);
    }

    function validUserProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'uid',
        'displayName',
        'email',
        'photoURL',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasAll([
        'uid',
        'displayName',
        'email',
        'photoURL',
        'createdAt',
        'updatedAt'
      ])
      && data.uid == userId
      && data.displayName is string
      && data.displayName.size() <= 200
      && data.email is string
      && data.email.size() <= 320
      && data.photoURL is string
      && data.photoURL.size() <= 2048
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function validUserSettings() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'goalWeightKg',
        'calorieGoal',
        'proteinGoal',
        'waterGoalMl',
        'updatedAt'
      ])
      && data.keys().hasAll([
        'goalWeightKg',
        'calorieGoal',
        'proteinGoal',
        'waterGoalMl',
        'updatedAt'
      ])
      && data.goalWeightKg is number
      && data.goalWeightKg >= 25
      && data.goalWeightKg <= 300
      && data.calorieGoal is int
      && data.calorieGoal >= 500
      && data.calorieGoal <= 20000
      && data.proteinGoal is int
      && data.proteinGoal >= 20
      && data.proteinGoal <= 1000
      && data.waterGoalMl is int
      && data.waterGoalMl >= 500
      && data.waterGoalMl <= 15000
      && data.updatedAt is timestamp;
    }

    function validDailyLog(date) {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'schemaVersion',
        'date',
        'timezone',
        'weightKg',
        'sleepHours',
        'caloriesConsumed',
        'proteinConsumed',
        'carbohydratesConsumed',
        'fatConsumed',
        'fibreConsumed',
        'waterMl',
        'workoutStatus',
        'workoutSessionId',
        'cardioStatus',
        'habitDone',
        'moodLevel',
        'energyLevel',
        'sorenessLevel',
        'steps',
        'journalNotes',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasAll([
        'schemaVersion',
        'date',
        'timezone',
        'weightKg',
        'sleepHours',
        'caloriesConsumed',
        'proteinConsumed',
        'carbohydratesConsumed',
        'fatConsumed',
        'fibreConsumed',
        'waterMl',
        'workoutStatus',
        'workoutSessionId',
        'cardioStatus',
        'habitDone',
        'moodLevel',
        'energyLevel',
        'sorenessLevel',
        'steps',
        'journalNotes',
        'createdAt',
        'updatedAt'
      ])
      && validDateKey(date)
      && !isFutureDateKey(date)
      && data.schemaVersion == 1
      && data.date == date
      && data.timezone is string
      && data.timezone.size() > 0
      && data.timezone.size() <= 100
      && validNullableNumber(data.weightKg, 25, 300)
      && validNullableNumber(data.sleepHours, 0, 24)
      && data.caloriesConsumed is int
      && data.caloriesConsumed >= 0
      && data.caloriesConsumed <= 20000
      && data.proteinConsumed is int
      && data.proteinConsumed >= 0
      && data.proteinConsumed <= 1000
      && data.carbohydratesConsumed is int
      && data.carbohydratesConsumed >= 0
      && data.carbohydratesConsumed <= 2000
      && data.fatConsumed is int
      && data.fatConsumed >= 0
      && data.fatConsumed <= 1000
      && data.fibreConsumed is int
      && data.fibreConsumed >= 0
      && data.fibreConsumed <= 200
      && data.waterMl is int
      && data.waterMl >= 0
      && data.waterMl <= 15000
      && validActivityStatus(data.workoutStatus)
      && (data.workoutSessionId == null || (data.workoutSessionId is string && data.workoutSessionId.size() > 0 && data.workoutSessionId.size() <= 128))
      && validActivityStatus(data.cardioStatus)
      && data.habitDone is bool
      && validScale(data.moodLevel)
      && validScale(data.energyLevel)
      && validScale(data.sorenessLevel)
      && (data.steps == null || (data.steps is int && data.steps >= 0 && data.steps <= 200000))
      && data.journalNotes is string
      && data.journalNotes.size() <= 2000
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function validWorkoutSession() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'schemaVersion', 'date', 'title', 'status', 'exercises', 'notes',
        'startedAt', 'completedAt', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasAll([
        'schemaVersion', 'date', 'title', 'status', 'exercises', 'notes',
        'startedAt', 'completedAt', 'createdAt', 'updatedAt'
      ])
      && data.schemaVersion == 1
      && validDateKey(data.date)
      && data.title is string && data.title.size() > 0 && data.title.size() <= 80
      && data.status in ['active', 'completed']
      && data.exercises is list && data.exercises.size() <= 30
      && data.notes is string && data.notes.size() <= 2000
      && data.startedAt is timestamp
      && (data.completedAt == null || data.completedAt is timestamp)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validUserProfile(userId);
      allow update: if owns(userId)
        && validUserProfile(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;

      match /settings/{document} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId) && validUserSettings();
        allow update: if owns(userId) && validUserSettings();
      }

      match /dailyMetrics/{date} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId) && validDailyLog(date);
        allow update: if owns(userId)
          && validDailyLog(date)
          && (
            !resource.data.keys().hasAny(['createdAt'])
            || request.resource.data.createdAt == resource.data.createdAt
            || request.resource.data.createdAt == request.time
          );
      }

      match /workoutSessions/{sessionId} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId) && validWorkoutSession();
        allow update: if owns(userId)
          && validWorkoutSession()
          && request.resource.data.createdAt == resource.data.createdAt
          && (resource.data.status != 'completed' || request.resource.data.status == 'completed');
      }
    }
  }
}
