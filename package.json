{
  "name": "project99",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-project99-rules \"vitest run --config vitest.rules.config.mts\"",
    "architecture:generate": "tsc --project tsconfig.architecture.json && node dist/architecture-scripts/scripts/architecture/generate-observatory.js",
    "architecture:check": "tsc --project tsconfig.architecture.json && node dist/architecture-scripts/scripts/architecture/check-freshness.js",
    "env:setup": "node scripts/setup-env.mjs",
    "rules:deploy:dev": "npx --yes firebase-tools@15 deploy --only firestore:rules --project dev",
    "rules:deploy:prod": "npx --yes firebase-tools@15 deploy --only firestore:rules --project prod"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "firebase": "^12.17.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  }
}
